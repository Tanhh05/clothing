# Spring profile
SPRING_PROFILES_ACTIVE=deploy

# App
APP_PORT=8080
APP_CORS_ALLOWED_ORIGINS=https://clothing-git-main-tanh-s-projects1.vercel.app
JWT_SECRET=replace-with-strong-random-jwt-secret-min-32-bytes
JWT_EXPIRATION_SECONDS=86400
JWT_REFRESH_EXPIRATION_SECONDS=2592000

# Supabase Postgres (Direct connection or Session Pooler)
# Direct host format: db.<project-ref>.supabase.co (IPv6)
# Pooler host format: aws-0-<region>.pooler.supabase.com (IPv4)
DB_HOST=db.gfikmhogqbykcqsqsbtl.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=replace-with-supabase-db-password

# Optional integrations
REDIS_ENABLED=false
RABBITMQ_ENABLED=false
ELASTICSEARCH_ENABLED=false

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_JWK_SET_URI=https://www.googleapis.com/oauth2/v3/certs
GOOGLE_ALLOWED_ISSUERS=https://accounts.google.com,accounts.google.com

# Cloudflare R2 (optional)
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=clothing-assets
R2_ENDPOINT=
R2_REGION=auto
R2_PUBLIC_BASE_URL=
R2_PRESIGN_EXPIRATION_MINUTES=15
R2_MAX_FILE_SIZE_BYTES=10485760
R2_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp,image/avif
R2_IMAGE_CACHE_CONTROL=public, max-age=31536000, immutable

# GHN (optional)
GHN_BASE_URL=https://online-gateway.ghn.vn/shiip/public-api/master-data
GHN_SHIPPING_BASE_URL=https://online-gateway.ghn.vn/shiip/public-api/v2/shipping-order
GHN_TOKEN=
GHN_SHOP_ID=

# MoMo (optional)
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_REDIRECT_URL=https://clothing-git-main-tanh-s-projects1.vercel.app/orders
MOMO_IPN_URL=https://<your-api-domain>/api/payments/momo/ipn
MOMO_REQUEST_TYPE=captureWallet

# VNPAY (optional)
VNPAY_ENDPOINT=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=https://clothing-git-main-tanh-s-projects1.vercel.app/orders
VNPAY_IPN_URL=https://<your-api-domain>/api/payments/vnpay/ipn
VNPAY_LOCALE=vn
VNPAY_ORDER_TYPE=other
VNPAY_IP_ADDRESS=127.0.0.1
VNPAY_EXPIRE_MINUTES=15
