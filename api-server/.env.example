# App
APP_PORT=8080
JAVA_OPTS=-Xms96m -Xmx192m -XX:+UseSerialGC -Duser.timezone=Asia/Ho_Chi_Minh
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
JPA_DDL_AUTO=validate
SPRING_FLYWAY_ENABLED=true
SEARCH_TIMEOUT_MS=400
SEARCH_FALLBACK_MAX_SIZE=20
SEARCH_METRICS_WINDOW_SIZE=200

# JWT
JWT_SECRET=replace-with-strong-random-jwt-secret-min-32-bytes
JWT_EXPIRATION_SECONDS=86400
JWT_REFRESH_EXPIRATION_SECONDS=2592000
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_JWK_SET_URI=https://www.googleapis.com/oauth2/v3/certs
GOOGLE_ALLOWED_ISSUERS=https://accounts.google.com,accounts.google.com

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=clothing
DB_USER=clothing
DB_PASSWORD=replace-with-db-password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Elasticsearch
ELASTICSEARCH_URIS=http://elasticsearch:9200
ELASTICSEARCH_ES_JAVA_OPTS=-Xms192m -Xmx192m

# Docker runtime limits (low-RAM defaults)
POSTGRES_MEM_LIMIT=320m
POSTGRES_CPUS=0.35
REDIS_MEM_LIMIT=96m
REDIS_CPUS=0.15
RABBITMQ_MEM_LIMIT=192m
RABBITMQ_CPUS=0.2
ELASTICSEARCH_MEM_LIMIT=512m
ELASTICSEARCH_CPUS=0.3
BE_MEM_LIMIT=320m
BE_CPUS=0.35

# Cloudflare R2 (Direct upload by FE via presigned URL)
R2_ACCOUNT_ID=replace-with-r2-account-id
R2_ACCESS_KEY=replace-with-r2-access-key
R2_SECRET_KEY=replace-with-r2-secret-key
R2_BUCKET=clothing-assets
R2_ENDPOINT=https://replace-with-r2-account-id.r2.cloudflarestorage.com
R2_REGION=auto
R2_PUBLIC_BASE_URL=https://replace-with-public-cdn-domain.r2.dev
R2_PRESIGN_EXPIRATION_MINUTES=15
R2_MAX_FILE_SIZE_BYTES=10485760
R2_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp,image/avif
R2_IMAGE_CACHE_CONTROL=public, max-age=31536000, immutable

# GHN Address API
GHN_BASE_URL=https://online-gateway.ghn.vn/shiip/public-api/master-data
GHN_SHIPPING_BASE_URL=https://online-gateway.ghn.vn/shiip/public-api/v2/shipping-order
GHN_TOKEN=replace-with-ghn-token
GHN_SHOP_ID=replace-with-ghn-shop-id

# MoMo Payment
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_PARTNER_CODE=replace-with-momo-partner-code
MOMO_ACCESS_KEY=replace-with-momo-access-key
MOMO_SECRET_KEY=replace-with-momo-secret-key
MOMO_REDIRECT_URL=http://localhost:5173/orders
MOMO_IPN_URL=http://localhost:8080/api/payments/momo/ipn
MOMO_REQUEST_TYPE=captureWallet

# VNPAY
VNPAY_ENDPOINT=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=replace-with-vnpay-tmn-code
VNPAY_HASH_SECRET=replace-with-vnpay-hash-secret
VNPAY_RETURN_URL=http://localhost:5173/orders
VNPAY_IPN_URL=http://localhost:8080/api/payments/vnpay/ipn
VNPAY_LOCALE=vn
VNPAY_ORDER_TYPE=other
VNPAY_IP_ADDRESS=127.0.0.1
VNPAY_EXPIRE_MINUTES=15
