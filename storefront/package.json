{
  "name": "clothing",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "clean": "rm -rf .next",
    "dev": "next dev -p 3000",
    "dev:reset": "npm run clean && next dev -p 3000",
    "dev:restart": "pkill -f \"next dev -p 3000\" || true; npm run clean; next dev -p 3000",
    "lint": "next lint",
    "build": "npm run clean && next build",
    "start": "next start",
    "e2e": "playwright test",
    "e2e:client": "playwright test --project=client",
    "e2e:admin": "playwright test --project=admin"
  },
  "dependencies": {
    "@headlessui/react": "^1.0.0",
    "animate.css": "^4.1.1",
    "axios": "^0.26.0",
    "cookies-next": "^2.0.4",
    "next": "^12.1.0",
    "next-pwa": "^5.4.4",
    "nprogress": "^0.2.0",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "swiper": "^6.6.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/nprogress": "^0.2.0",
    "@types/react": "^17.0.3",
    "autoprefixer": "^10.2.5",
    "eslint": "8.9.0",
    "eslint-config-next": "12.1.0",
    "playwright": "^1.60.0",
    "postcss": "^8.2.9",
    "tailwindcss": "^2.1.1",
    "typescript": "^4.2.4"
  }
}
